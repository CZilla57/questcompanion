# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/focusquest

# ── OAuth / OIDC ─────────────────────────────────────────
# Get these from your OIDC provider (Google Cloud Console, Auth0, Clerk, etc.)
OAUTH_CLIENT_ID=your-client-id-here
OAUTH_CLIENT_SECRET=your-client-secret-here

# OIDC discovery URL — defaults to Google if not set
# Google:  https://accounts.google.com
# Auth0:   https://YOUR_TENANT.auth0.com
# Clerk:   https://YOUR_FRONTEND_API.clerk.accounts.dev
ISSUER_URL=https://accounts.google.com

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (without https:// prefix)
# e.g. focusquest.app,localhost:5173
ALLOWED_ORIGINS=localhost:5173

# ── Web Push (VAPID) ─────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# ── Apple Push (APNs, native iOS) ────────────────────────
# Direct APNs with token auth. When any of the four required vars is unset,
# native-iOS push is a no-op (dev/CI run normally). Provision in the Apple
# Developer portal: App ID → enable Push Notifications, then Keys → create an
# APNs Auth Key (.p8). Paste the FULL .p8 contents (BEGIN/END lines + newlines)
# as APNS_AUTH_KEY — on Render, its multi-line secret field accepts it verbatim.
APNS_AUTH_KEY=
# 10-char Key ID shown next to the key you created.
APNS_KEY_ID=
# 10-char Team ID (Apple Developer → Membership).
APNS_TEAM_ID=
# The iOS app's bundle identifier (used as the apns-topic).
APNS_BUNDLE_ID=
# 'sandbox' for builds run from Xcode (debug/dev on a device or simulator),
# 'production' for TestFlight and App Store builds.
APNS_ENV=sandbox

# ── Cron ─────────────────────────────────────────────────
# Shared secret for the POST /api/cron/tick endpoint
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── AI — text (Gemini) ───────────────────────────────────
# Free API key from https://aistudio.google.com/apikey
# When unset, text-AI features (smart parse, breakdown, questline drafting,
# difficulty variants, reflection) return 503 and the app runs normally.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# ── AI — voice transcription (Groq Whisper) ──────────────
# Free API key (no credit card) from https://console.groq.com/keys
# Used ONLY for voice quick-add transcription. When unset, voice input
# returns 503 and the app runs normally.
GROQ_API_KEY=

# ── Render (deploy inspection — local tooling only) ──────
# Read-only convenience for `pnpm --filter @workspace/scripts render-status`,
# which reports recent deploys and their logs. NOT needed to run the app, and
# NOT set on Render itself — this is for querying Render from your machine.
# Create at: Render Dashboard → Account Settings → API Keys.
# Treat it like a password: it can read and modify every service on the account.
RENDER_API_KEY=
# Optional — skips a lookup if set. Find it in the service URL:
# dashboard.render.com/web/srv-XXXXXXXX
RENDER_SERVICE_ID=

# ── Server ───────────────────────────────────────────────
PORT=8080
NODE_ENV=development
