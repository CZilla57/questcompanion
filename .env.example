# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/focusquest

# ── OAuth / OIDC ─────────────────────────────────────────
# Get these from your OIDC provider (Google Cloud Console, Auth0, Clerk, etc.)
OAUTH_CLIENT_ID=your-client-id-here
OAUTH_CLIENT_SECRET=your-client-secret-here

# OIDC discovery URL — defaults to Google if not set
# Google:  https://accounts.google.com
# Auth0:   https://YOUR_TENANT.auth0.com
# Clerk:   https://YOUR_FRONTEND_API.clerk.accounts.dev
ISSUER_URL=https://accounts.google.com

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (without https:// prefix)
# e.g. focusquest.app,localhost:5173
ALLOWED_ORIGINS=localhost:5173

# ── Web Push (VAPID) ─────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# ── Cron ─────────────────────────────────────────────────
# Shared secret for the POST /api/cron/tick endpoint
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── AI (Gemini) ──────────────────────────────────────────
# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# When unset, the AI breakdown feature returns 503 and the app runs normally.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# ── Server ───────────────────────────────────────────────
PORT=8080
NODE_ENV=development
