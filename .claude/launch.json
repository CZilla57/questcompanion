{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--enable-source-maps", "artifacts/api-server/dist/index.mjs"],
      "port": 8080,
      "env": {
        "PORT": "8080",
        "NODE_ENV": "development"
      }
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workspace/focusquest", "run", "dev"],
      "port": 5173
    }
  ]
}
